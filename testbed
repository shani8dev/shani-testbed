#!/usr/bin/env bash
# testbed — entry point for shani-testbed, the ShaniOS test harness.
#
# This file only locates the image repo, loads the modules and dispatches.
# The implementation lives in lib/, one module per area:
#
#   lib/common.sh   paths/state (DATA_DIR, MNT, images...), argument helpers,
#                   container prerequisites (machine-id, dbus, sudo)
#   lib/disk.sh     loop devices, install.img, `disk` (compat), `clean`
#   lib/pki.sh      throwaway CA + leaf certs, local HTTPS mirror (`ca`, `serve`)
#   lib/install.sh  real install.sh/configure.sh (`install`, `configure`,
#                   `bootstrap`), `pacstrap` signature smoke test
#   lib/nspawn.sh   slot overlay, --local-src overlay, nspawn args, the
#                   shared background-boot lifecycle
#   lib/boot.sh     `enter`, `verify-boot`, `probe`, `desktop`
#   lib/deploy.sh   real shani-deploy/shani-update (`upgrade`, `update-check`,
#                   `rollback`, `reboot`, `cycle`)
#   lib/app.sh      `app`: run a GUI app inside a slot and drive it (click,
#                   type, key, screenshot, window waits/asserts)
#   lib/qemu.sh     OVMF boots (`qemu`, `iso`) and the `watch` page — HOST-ONLY
#   lib/gui.sh      headless OVMF+QMP+guest-agent desktop driving — HOST-ONLY
#   lib/vmspawn.sh  systemd-vmspawn UEFI boot + swtpm, works without KVM — HOST-ONLY
#   lib/suite.sh    `suite` (the mandatory sequence as one command), `status`
#   lib/usage.sh    usage text
#
# shani-testbed tests the images and scripts of shani-install-media (the
# "image repo"): it reads its config/config.sh, image_profiles/, cache/output
# and keeps its state in <image repo>/test-env/disk/. Normal use goes through
# the image repo's builder-container runner, whose test-env/test.sh is a shim
# that execs this file (the runner mounts this repo at /opt/shani-testbed):
#   cd ../shani-install-media && ./run_in_container.sh build.sh test <command> [options]
# HOST-ONLY commands (qemu, gui, iso, watch, vmspawn) run directly:
#   ../shani-testbed/testbed <command> [options]
# Image repo lookup: $SHANI_INSTALL_MEDIA, else /home/builduser/build inside
# the builder container, else ../shani-install-media next to this repo.
set -Eeuo pipefail
TESTBED_ROOT="$(dirname "$(realpath "$0")")"
_find_media_root() {
  local c
  for c in "${SHANI_INSTALL_MEDIA:-}" /home/builduser/build "${TESTBED_ROOT}/../shani-install-media"; do
    [[ -n "$c" && -f "$c/config/config.sh" && -d "$c/image_profiles" ]] && { realpath "$c"; return 0; }
  done
  echo "shani-testbed: cannot find the shani-install-media checkout (set SHANI_INSTALL_MEDIA)" >&2
  exit 2
}
MEDIA_ROOT="$(_find_media_root)"
# config.sh resolves OUTPUT_DIR etc. relative to CWD ("./cache/output"), so
# run from the image repo root, same as build.sh.
cd "$MEDIA_ROOT"
source "${MEDIA_ROOT}/config/config.sh"
# Kept for the existing module code: SCRIPT_DIR is the image repo's test-env/
# (state lives in its disk/), REPO_ROOT the image repo itself.
SCRIPT_DIR="${MEDIA_ROOT}/test-env"

LIB_DIR="${TESTBED_ROOT}/lib"
for _module in common disk pki install nspawn boot deploy app qemu gui vmspawn isoinstall suite gate usage; do
  # shellcheck source=/dev/null
  source "${LIB_DIR}/${_module}.sh"
done
unset _module

[[ $# -lt 1 ]] && usage

COMMAND="$1"
shift

case "$COMMAND" in
  disk)         cmd_disk "$@" ;;
  pacstrap)     cmd_pacstrap "$@" ;;
  ca)           cmd_ca "$@" ;;
  bootstrap)    cmd_bootstrap "$@" ;;
  serve)        cmd_serve "$@" ;;
  enter)        cmd_enter "$@" ;;
  verify-boot)  cmd_verifyboot "$@" ;;
  desktop)      cmd_desktop "$@" ;;
  probe)        cmd_probe "$@" ;;
  slot-test)    cmd_slot_test "$@" ;;
  app)          cmd_app "$@" ;;
  install)      cmd_install "$@" ;;
  configure)    cmd_configure "$@" ;;
  upgrade)      cmd_upgrade "$@" ;;
  update-check) cmd_updatecheck "$@" ;;
  reboot)       cmd_reboot "$@" ;;
  rollback)     cmd_rollback "$@" ;;
  cycle)        cmd_cycle "$@" ;;
  suite)        cmd_suite "$@" ;;
  gate)         cmd_gate "$@" ;;
  iso-install)  cmd_iso_install "$@" ;;
  status)       cmd_status "$@" ;;
  qemu)         cmd_qemu "$@" ;;
  gui)          cmd_gui "$@" ;;
  watch)        cmd_watch "$@" ;;
  iso)          cmd_iso "$@" ;;
  vmspawn)      cmd_vmspawn "$@" ;;
  clean)        cmd_clean "$@" ;;
  -h|--help|help) usage ;;
  *)            usage ;;
esac
# a command that ran install.sh or shani-deploy may have swapped-on the test
# disk's swapfile - on the host kernel (see _release_test_swap)
mountpoint -q "${MNT:-/nonexistent}" 2>/dev/null && _swapoff_under "$MNT"
true
